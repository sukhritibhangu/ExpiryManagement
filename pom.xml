<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.expiryalert</groupId>
    <artifactId>expiry-alert-ledger</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Expiry Alert Ledger</name>
    <description>Household and small-inventory expiry tracker with console, web and JavaFX UIs.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <h2.version>2.3.232</h2.version>
        <main.class>app.Main</main.class>
        <ledger.browser.exclude>browser/**</ledger.browser.exclude>
        <jpro.version>2026.3.0</jpro.version>
        <ledger.port>8080</ledger.port>
        <ledger.release.platform>current</ledger.release.platform>
    </properties>

    <dependencies>
        <!-- JDBC database used when -Dledger.storage=jdbc is set (embedded, no server). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!-- JavaFX UI (topic 12/13). Not needed by the console app or the web dashboard. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- This project keeps packages directly under src/ (model, service, storage, util, app, web, gui). -->
        <sourceDirectory>${project.basedir}/src</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <exclude>test/**</exclude>
                        <exclude>${ledger.browser.exclude}</exclude>
                        <exclude>main/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- mvn package produces a runnable jar for the console app. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- mvn exec:java  ->  console application -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- mvn javafx:run  ->  JavaFX desktop window -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>gui.LedgerApp</mainClass>
                </configuration>
            </plugin>

            <!-- mvn dependency:copy-dependencies -> puts h2 and JavaFX jars in lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <outputDirectory>${project.basedir}/lib</outputDirectory>
                    <includeScope>runtime</includeScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>jpro</id>
            <properties>
                <ledger.browser.exclude>unused/**</ledger.browser.exclude>
                <javafx.version>24.0.2</javafx.version>
                <maven.compiler.release>22</maven.compiler.release>
            </properties>
            <repositories>
                <repository>
                    <id>jpro</id>
                    <url>https://sandec.jfrog.io/artifactory/repo/</url>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>jpro</id>
                    <url>https://sandec.jfrog.io/artifactory/repo/</url>
                </pluginRepository>
            </pluginRepositories>
            <dependencies>
                <dependency>
                    <groupId>one.jpro</groupId>
                    <artifactId>jpro-webapi</artifactId>
                    <version>${jpro.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>one.jpro.platform</groupId>
                    <artifactId>jpro-file</artifactId>
                    <version>0.7.3</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>one.jpro</groupId>
                        <artifactId>jpro-maven-plugin</artifactId>
                        <version>${jpro.version}</version>
                        <configuration>
                            <mainClassName>browser.BrowserLedgerApp</mainClassName>
                            <port>${ledger.port}</port>
                            <releaseName>ledger</releaseName>
                            <releasePlatforms>
                                <platform>${ledger.release.platform}</platform>
                            </releasePlatforms>
                            <jproVersion>${jpro.version}</jproVersion>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
